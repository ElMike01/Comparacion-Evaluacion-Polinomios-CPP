// polynomial_evaluation.cpp
#include <iostream>
#include <vector>
#include <chrono>
#include <random>
#include <fstream>
#include <iomanip>
#include <cmath>
#include <filesystem>

// Método estándar de evaluación de polinomios
// P(x) = a_n * x^n + a_{n-1} * x^{n-1} + ... + a_1 * x + a_0
// Donde coefficients = [a_n, a_{n-1}, ..., a_1, a_0]
double evaluateStandard(const std::vector<double>& coefficients, double x) {
    double result = 0.0;
    const int n = coefficients.size() - 1;
    
    for (int i = 0; i <= n; ++i) {
        // Calcular x^(n-i) y multiplicar por el coeficiente correspondiente
        // Usamos pow() para mayor claridad, aunque no es la implementación más eficiente
        // Esto representa mejor el método "estándar" de evaluación
        result += coefficients[i] * std::pow(x, n - i);
    }
    
    return result;
}

// Método de Horner para evaluación de polinomios
// P(x) = (...((a_n * x + a_{n-1}) * x + a_{n-2}) * x + ... + a_1) * x + a_0
// Donde coefficients = [a_n, a_{n-1}, ..., a_1, a_0]
double evaluateHorner(const std::vector<double>& coefficients, double x) {
    double result = 0.0;
    
    for (const double& coef : coefficients) {
        result = result * x + coef;
    }
    
    return result;
}

// Genera un vector de coeficientes aleatorios entre -10 y 10
// El primer elemento es el coeficiente de mayor grado (a_n)
std::vector<double> generateRandomCoefficients(int n) {
    std::vector<double> coefficients(n + 1);
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_int_distribution<> distr(-10, 10);
    
    for (int i = 0; i <= n; ++i) {
        coefficients[i] = distr(gen);
    }
    
    // Asegurar que el coeficiente principal (a_n) no sea cero
    while (std::abs(coefficients[0]) < 0.1) {
        coefficients[0] = distr(gen);
    }
    
    return coefficients;
}

// Genera un valor aleatorio para x entre -10 y 10, excluyendo 0
double generateRandomX() {
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_real_distribution<> distr(-10.0, 10.0);
    
    double x = distr(gen);
    // Asegurarnos que x no sea cercano a cero
    while (std::abs(x) < 0.1) {
        x = distr(gen);
    }
    
    return x;
}

// Estructura para almacenar los resultados de tiempo
struct TimeResults {
    int degree;
    double standard_time;
    double horner_time;
};

// Función principal de experimentación
TimeResults runExperiment(int degree, int repetitions) {
    TimeResults results;
    results.degree = degree;
    
    // Generar coeficientes aleatorios y punto de evaluación
    std::vector<double> coefficients = generateRandomCoefficients(degree);
    double x = generateRandomX();
    
    // Variables para medir el tiempo
    double total_time_standard = 0.0;
    double total_time_horner = 0.0;
    double result_standard, result_horner;
    
    // Ejecutar una vez para calentar la caché y verificar resultados
    result_standard = evaluateStandard(coefficients, x);
    result_horner = evaluateHorner(coefficients, x);
    
    // Verificar que ambos métodos den el mismo resultado (dentro de un margen de error)
    if (std::abs(result_standard - result_horner) > 1e-8) {
        std::cerr << "¡Advertencia! Los métodos dieron resultados diferentes." << std::endl;
        std::cerr << "Standard: " << result_standard << ", Horner: " << result_horner << std::endl;
        std::cerr << "Diferencia: " << std::abs(result_standard - result_horner) << std::endl;
    }
    
    // Repetir el experimento varias veces para obtener un promedio fiable
    for (int rep = 0; rep < repetitions; ++rep) {
        // Medir tiempo para el método estándar
        auto start_standard = std::chrono::high_resolution_clock::now();
        result_standard = evaluateStandard(coefficients, x);
        auto end_standard = std::chrono::high_resolution_clock::now();
        
        std::chrono::duration<double, std::micro> duration_standard = end_standard - start_standard;
        total_time_standard += duration_standard.count();
        
        // Medir tiempo para el método de Horner
        auto start_horner = std::chrono::high_resolution_clock::now();
        result_horner = evaluateHorner(coefficients, x);
        auto end_horner = std::chrono::high_resolution_clock::now();
        
        std::chrono::duration<double, std::micro> duration_horner = end_horner - start_horner;
        total_time_horner += duration_horner.count();
    }
    
    // Calcular los tiempos promedio
    results.standard_time = total_time_standard / repetitions;
    results.horner_time = total_time_horner / repetitions;
    
    return results;
}

// Crea un directorio si no existe
void createDirectoryIfNotExists(const std::string& dirPath) {
    if (!std::filesystem::exists(dirPath)) {
        std::filesystem::create_directories(dirPath);
        std::cout << "Directorio creado: " << dirPath << std::endl;
    }
}

int main() {
    // Parámetros del experimento
    const int MAX_DEGREE = 1000;
    const int STEP = 10;
    const int REPETITIONS = 1000;
    
    // Crear directorios necesarios
    createDirectoryIfNotExists("data");
    createDirectoryIfNotExists("docs");
    
    // Archivo para guardar los resultados
    std::ofstream outfile("data/results.csv");
    if (!outfile) {
        std::cerr << "Error: No se pudo abrir el archivo de resultados" << std::endl;
        return 1;
    }
    
    outfile << "grado,tiempo_promedio_estandar,tiempo_promedio_horner" << std::endl;
    
    std::cout << "Iniciando experimentos..." << std::endl;
    
    // Ejecutar experimentos para varios grados de polinomios
    for (int degree = 10; degree <= MAX_DEGREE; degree += STEP) {
        std::cout << "Evaluando polinomio de grado " << degree << "..." << std::endl;
        
        // Ejecutar el experimento
        TimeResults results = runExperiment(degree, REPETITIONS);
        
        // Guardar resultados en el archivo CSV
        outfile << results.degree << ","
                << std::fixed << std::setprecision(6) << results.standard_time << ","
                << std::fixed << std::setprecision(6) << results.horner_time << std::endl;
        
        // Mostrar resultados parciales
        std::cout << "  Método estándar: " << results.standard_time << " μs" << std::endl;
        std::cout << "  Método de Horner: " << results.horner_time << " μs" << std::endl;
        std::cout << "  Proporción: " << results.standard_time / results.horner_time << " veces más rápido Horner" << std::endl;
        std::cout << std::endl;
    }
    
    outfile.close();
    std::cout << "Experimentos completados. Los resultados se guardaron en 'data/results.csv'" << std::endl;
    
    return 0;
}
